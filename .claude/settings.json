{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Task",
      "Skill",
      "Bash(bash scripts/*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(cat *)",
      "Bash(git -C *)",
      "Bash(git worktree *)",
      "Bash(git diff *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git status*)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(gh *)",
      "Bash(which codex *)",
      "Bash(codex *)",
      "Bash(trash *)",
      "Bash(mkdir -p .tmp*)",
      "Bash(mkdir -p .swe*)",
      "Bash(mkdir -p .worktrees*)",
      "Write(.tmp/*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
